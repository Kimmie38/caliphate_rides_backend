# ---- Server ----
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://api.caliphaterides.com.ng

# ---- Database (on the VPS) ----
# PASTE the MONGODB_URI line that ./scripts/vps-mongo-setup.sh prints, replacing this one
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/caliphates_rides?retryWrites=true&w=majority

# ---- Security ----
# PASTE the JWT_SECRET from Render (Environment → JWT_SECRET → eye icon) so everyone stays signed in.
# Or make a new one on the VPS with:  openssl rand -hex 48   (everyone then signs in again once)
JWT_SECRET=
JWT_DAYS=30

# ---- Sign-in codes ----
# Codes appear in the server log until Termii is set up
SMS_PROVIDER=console
ALLOW_CONSOLE_SMS=true
TERMII_SENDER_ID=Caliphate
TERMII_CHANNEL=dnd

# ---- Payments ----
# Flutterwave (test) for now. Switch to monnify when you have the Monnify keys (see MONNIFY.md).
PAYMENT_PROVIDER=flutterwave
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
PAYMENT_FALLBACK_EMAIL_DOMAIN=riders.caliphaterides.com.ng
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT=

# ---- Maps (our own servers, same VPS) ----
ROUTING_URL=http://caliphate-routing:5000
KEEP_ROUTING_AWAKE=false
MAP_TILES_URL=https://tiles.caliphaterides.com.ng/sokoto
MAP_GLYPHS_URL=https://tiles.caliphaterides.com.ng/font/{fontstack}/{range}

# Testing outside Sokoto. Delete this line for launch (rides then only start in Sokoto).
SERVICE_AREA=anywhere

# ---- Matching ----
MATCH_RADIUS_M=7000
OFFER_SECONDS=20
MATCH_TIMEOUT_SECONDS=90

# ---- Driver document photos ----
STORAGE=mongo



MONGODB_URI=mongodb://USER:PASSWORD@caliphate-mongo:27017/caliphate?authSource=admin


