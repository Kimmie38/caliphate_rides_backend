# Copy to .env and fill in. Never commit .env.

# ---- Server ----
PORT=4000
NODE_ENV=development
# The public address of this API (used for Flutterwave return links and document links)
PUBLIC_URL=http://localhost:4000
# Comma-separated web origins allowed to call the API (the admin dashboard). * = any (development only)
CORS_ORIGINS=*

# ---- Database ----
# MongoDB connection string, e.g. from MongoDB Atlas: mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/caliphate
MONGODB_URI=mongodb+srv://kimrwang9_db_user:keepout8888@cluster0.gvzyqhi.mongodb.net/caliphates_rides?retryWrites=true&w=majority

# ---- Security ----
# Long random string used to sign logins. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts, in days
JWT_DAYS=30

# ---- Sign-in codes (SMS) ----
# console = print codes in the server log (development); termii = send real SMS through Termii
SMS_PROVIDER=console
TERMII_API_KEY=
# Your Termii base URL from the Termii dashboard, e.g. https://v3.api.termii.com
TERMII_BASE_URL=
# Approved sender ID on Termii
TERMII_SENDER_ID=Caliphate
# dnd delivers to numbers on Do-Not-Disturb lists (recommended for sign-in codes; ask Termii to enable it)
TERMII_CHANNEL=dnd
# Optional: one fixed test login for app-store reviewers (phone in +234 format and its fixed code)
TEST_PHONE=
TEST_CODE=

# ---- Payments and payouts (Flutterwave) ----
# Flutterwave dashboard → Settings → API Keys. FLWSECK_TEST-... while testing, FLWSECK-... for launch.
FLW_SECRET_KEY=
# Settings → Webhooks: make up a long random "secret hash", put it there and here.
FLW_WEBHOOK_HASH=
# Optional: logo shown on the Flutterwave checkout page (an https image URL)
FLW_LOGO_URL=
# Email used on Flutterwave receipts when a rider has no email on file
PAYMENT_FALLBACK_EMAIL_DOMAIN=riders.caliphaterides.ng

# ---- Maps ----
# Road routing (OSRM). Use your own server before launch (see the map server kit).
ROUTING_URL=https://router.project-osrm.org

# Where rides can start: west,south,east,north (default: Sokoto city, same as the app).
# Leave empty to allow pickups anywhere (useful for testing elsewhere).
SERVICE_AREA=5.10,12.85,5.35,13.15

# ---- Matching ----
# How far to look for drivers (metres) and how long each driver has to answer (seconds)
MATCH_RADIUS_M=7000
OFFER_SECONDS=20
# Give up and tell the rider no drivers are free after this many seconds
MATCH_TIMEOUT_SECONDS=90

# ---- Uploads (driver document photos) ----
# mongo = keep them inside MongoDB (works on hosts that wipe their disk on restart, like Render free)
# disk  = keep them in UPLOAD_DIR (a VPS with a lasting disk, e.g. Oracle Cloud free VM)
STORAGE=mongo
UPLOAD_DIR=./uploads

# ---- Admin dashboard (open /dashboard on this server) ----
# Map style for the "Map places" page. The free OpenFreeMap style works; use your own map server later.
ADMIN_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---- First admin (created by `npm run seed`) ----
ADMIN_EMAIL=admin@caliphaterides.ng
# At least 10 characters. Remove it from .env after seeding.
ADMIN_PASSWORD=adminpassword@123
ADMIN_NAME=Caliphate Admin
